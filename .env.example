# Copy this file to `.env` at the repo root and fill in the values for
# your machine. `.env` is gitignored so each checkout carries its own.
# All filesystem-path environment variables read by `magsr` are listed
# here — if a value isn't in this file, it isn't read anywhere in the
# codebase.

# ---- Optional ----------------------------------------------------------

# Override the default data directory (default: <repo>/data).
# Used for cached tile indices, processed WA tiles, etc.
# MAGSR_DATA_DIR=/path/to/data


# ---- Required for the KSA aligned backend (magsr.datasets.ksa_shield_aligned)
#
# Point this at your local copy of the co-registered KSA dataset — either built with
# scripts/build_ksa_dataset/00_ksa_preprocessing/ (see its README_ksa_data.md), or
# obtained from the project's dataset release. When you build it yourself this is
# `data/processed/ksa_aligned`. Expected layout below.
#
# Expected layout under $MAGSR_KSA_ALIGNED_ROOT (everything already
# co-registered on one EPSG:32637 grid, cubic-spline resampled):
#
#   00_base_grid/
#   ├── magnetic_base_grid30m.tif              # 30 m canonical grid template
#   ├── magnetic_base_grid60m.tif              # 60 m canonical grid template
#   ├── magnetic_base_grid180m.tif             # 180 m canonical grid template
#   ├── magnetic_mask_grid60m.tif              # uint8 block-ID raster
#   │                                          # (0 = no data, 1/2/3 = blocks)
#   └── msr_inference_grid180m.tif             # 180 m extended LR-inference grid
#
#   02_snap_owned/
#   ├── aeromagnetics/
#   │   ├── 60m/cubicspline/
#   │   │   └── snapped_cubicspline_MAG_{product}.tif
#   │   │       # product ∈ {AMF, AMF_RTP, AMF_ANS,
#   │   │       #            AMF_RTP1VD, AMF_RTP2VD, AMF_RTPHG, AMF_RTPTILT,
#   │   │       #            HGLAT, HGLONG}
#   │   │       # plus snapped_cubicspline_RTP.tif and
#   │   │       #      snapped_cubicspline_DTM.tif (no MAG_ prefix)
#   │   └── 180m/cubicspline/
#   │       └── snapped_cubicspline_{stem}.tif
#   │           # LR key ∈ {RTP, TMI, ANS, 1VD}
#   │           # on-disk stem ∈ {RTP, TMI, RTP_ANSIG, RTP_FVD}  (translated internally)
#   ├── elevation/
#   │   └── snapped_cubicspline_dem30m.tif     # 30 m DEM
#   └── multispectral/cubicspline/
#       └── snapped_landsat_b{1..7}.tif        # Landsat bands b1–b7 (optional; loader `ms_bands`
#                                              # pathway — no shipped experiment uses them)
#
#   03_inference_lr/cubicspline/
#   └── snapped_cubicspline_{stem}.tif         # LR rasters on the EXTENDED inference grid
#                                              # (NOT pixel-aligned with 00_base_grid —
#                                              #  use georeferenced lookup, not int math)
#
# Pixel sizes: HR 60 m, LR 180 m, DEM 30 m. Integer scale ratios on the
# canonical grid: 1 LR px = 3x3 HR px = 6x6 DEM px.
#
MAGSR_KSA_ALIGNED_ROOT=/path/to/ksa_aligned
